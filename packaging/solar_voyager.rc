// Windows 用リソース: exe のファイルアイコンとバージョン情報
#include <winver.h>

// GLFW はこの名前のアイコンをウィンドウのアイコンにも使う
GLFW_ICON ICON "@ICON_PATH@"

// UTF-8 コードページ（日本語パス対応）
1 24 "@MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription",  "Solar System Voyager"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "InternalName",     "solar_voyager"
      VALUE "OriginalFilename", "solar_voyager.exe"
      VALUE "ProductName",      "Solar System Voyager"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
      VALUE "CompanyName",      "hubstacksea"
      VALUE "LegalCopyright",   "Copyright (c) 2026 hubstacksea. MIT License. https://github.com/hubstacksea/Solar-System-Simulator"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
